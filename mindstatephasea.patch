+import { create } from "zustand";
+import { persist } from "zustand/middleware";
+
+type GameSlug = "tango" | "memory" | "crowns";
+type Medal = "gold" | "silver" | "bronze" | null;
+
+interface StageRecord {
+  completed: boolean;
+  medal: Medal;
+  bestTime: number | null;
+  bestXp: number | null;
+}
+
+interface ProgressState {
+  stages: Record<GameSlug, Record<number, StageRecord>>;
+  currentStage: Record<GameSlug, number>;
+  completeStage: (game: GameSlug, stage: number, record: Omit<StageRecord, "completed">) => void;
+  getStage: (game: GameSlug, stage: number) => StageRecord;
+}
+
+const empty = (): StageRecord => ({ completed: false, medal: null, bestTime: null, bestXp: null });
+
+export const useProgress = create<ProgressState>()(
+  persist(
+    (set, get) => ({
+      stages: { tango: {}, memory: {}, crowns: {} },
+      currentStage: { tango: 1, memory: 1, crowns: 1 },
+
+      completeStage(game, stage, record) {
+        set(s => ({
+          stages: {
+            ...s.stages,
+            [game]: { ...s.stages[game], [stage]: { ...record, completed: true } },
+          },
+          currentStage: {
+            ...s.currentStage,
+            [game]: Math.max(s.currentStage[game], stage + 1),
+          },
+        }));
+      },
+
+      getStage(game, stage) {
+        return get().stages[game]?.[stage] ?? empty();
+      },
+    }),
+    { name: "cup-clash-progress" }
+  )
+);
