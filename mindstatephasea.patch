@@ -0,0 +1,23 @@
+/** Simple deterministic PRNG (mulberry32) seeded by game + stage. */
+export function createRng(game: string, stage: number) {
+  let h = stage ^ 0xdeadbeef;
+  for (const c of game) h = Math.imul(h ^ c.charCodeAt(0), 0x9e3779b9);
+  h = h >>> 0;
+
+  return function (): number {
+    h |= 0;
+    h = h + 0x6d2b79f5 | 0;
+    let t = Math.imul(h ^ h >>> 15, 1 | h);
+    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
+    return ((t ^ t >>> 14) >>> 0) / 4294967296;
+  };
+}
+
+export function shuffle<T>(arr: T[], rng: () => number): T[] {
+  const a = [...arr];
+  for (let i = a.length - 1; i > 0; i--) {
+    const j = Math.floor(rng() * (i + 1));
+    [a[i], a[j]] = [a[j], a[i]];
+  }
+  return a;
+}
